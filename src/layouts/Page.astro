---
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;
---
<BaseLayout title={frontmatter.title}>
  <article class="page">
    <h1>{frontmatter.title}</h1>
    {frontmatter.image && (
      <img src={frontmatter.image} alt={frontmatter.title} class="featured-image" />
    )}
    <slot />
  </article>
</BaseLayout>